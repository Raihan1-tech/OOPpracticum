)

# Admin membuat kamar Standard
standard = KamarStandard(
    "Kamar Standard Superior",
    0,
    500_000,
    "2 Orang"
)

# Mencoba memasukkan stok negatif
standard.set_tambah_stok(-5)

# Memasukkan stok yang benar
standard.set_tambah_stok(20)


# PEMESANAN

daftar_pesanan = [
    {
        "kamar": deluxe,
        "malam": 2
    },
    {
        "kamar": standard,
        "malam": 1
    }
]


proses_transaksi(daftar_pesanan)
